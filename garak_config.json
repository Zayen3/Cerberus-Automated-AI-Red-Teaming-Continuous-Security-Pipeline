{
  "rest": {
    "RestGenerator": {
      "uri": "http://localhost:3000/api/chat",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "message": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "response",
      "request_timeout": 120
    }
  }
}